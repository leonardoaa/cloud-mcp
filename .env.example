MCP_HOST=127.0.0.1
MCP_PORT=37242
MCP_DOCKER_PORT=37242
MCP_PATH=/mcp
MCP_ALLOWED_ORIGINS=http://127.0.0.1:37242,http://localhost:37242,http://localhost:5173
MCP_SERVER_BEARER_TOKEN=change-me
MCP_ADMIN_PASSWORD=change-me
JIRA_CREDENTIALS_MASTER_KEY=replace-with-32-byte-base64-key
JIRA_DB_PATH=./data/jira-mcp.sqlite
JIRA_PROFILES_JSON=[]
MCP_CALL_LOG_RETENTION_DAYS=30
MCP_CALL_LOG_MAX_ROWS=100000
JIRA_ATTACHMENT_MAX_BYTES=10485760
MCP_WORKSPACES_HOST_ROOT=/Volumes/External HD/Projetos
MCP_WORKSPACES_CONTAINER_ROOT=/workspaces
SDD_CATALOG_PATH=./resources/sdd
